# saju-letter-backend가 실제로 호스팅되는 주소 — 이 사이트의 모든 API 호출 대상.
# 로컬 개발 기본값(saju-letter-backend를 `npm run dev`로 띄운 경우): http://localhost:4000
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# 이 사이트 자신이 실제로 호스팅되는 주소 — 공유 링크(OG 태그의 og:url)와 이메일 CTA에 쓴다.
# 로컬 개발 기본값: http://localhost:3200(saju-letter-newyear-campaign의 3100과 겹치지
# 않게 — 이관 전환기에 두 사이트를 동시에 띄울 수 있어야 한다).
NEXT_PUBLIC_WEB_BASE_URL="http://localhost:3200"

# 스토어 앱 설치 링크 — footer/데모 결과/궁합 결과의 다운로드 배지(AppDownloadLinks)에서 쓴다.
# 패키지명/번들ID가 정해지는 즉시 미리 채워둬도 안전하다 — 아래 두 LIVE 플래그가 꺼져 있으면
# URL이 있어도 버튼이 아니라 "준비 중" 상태로만 보여준다(src/lib/appLinks.ts 참고).
NEXT_PUBLIC_GOOGLE_PLAY_URL="https://play.google.com/store/apps/details?id=com.sajuletter.app"
NEXT_PUBLIC_APP_STORE_URL=""

# 실제로 스토어 심사를 통과해 공개 다운로드가 가능해진 시점에만 "true"로 바꾼다(안드로이드
# 우선 출시 방침상 두 값은 서로 다른 시점에 켜질 수 있다). 기본값(미설정/그 외 값)은 전부
# "아직 준비 중"으로 취급한다.
NEXT_PUBLIC_ANDROID_APP_LIVE=""
NEXT_PUBLIC_IOS_APP_LIVE=""

# Cloudflare Turnstile 사이트 키(공개 키, 시크릿 키는 saju-letter-backend 쪽에 별도로 있음).
# 생략하면(로컬 개발 기본값) 위젯 자체를 렌더링하지 않는다 — 봇 방지 없이 폼 제출은 그대로 된다
# (백엔드의 fail-open과 짝을 이룸). 실제 서비스 오픈 전 Cloudflare 대시보드에서 발급받을 것.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Google Analytics 4 측정 ID(마케팅 사이트 전용 웹 스트림, 2026-09-07 도입) — saju-letter-mobile의
# Firebase Analytics(GA4 for Firebase)와 같은 GA4 프로퍼티(saju-letter-20575)에 딸린 별도 "웹"
# 데이터 스트림이다. Firebase 콘솔 > 프로젝트 설정 > 일반 > "앱 추가" > 웹에서 새 스트림을 만들면
# G-로 시작하는 값이 발급된다. 생략하면(로컬 개발 기본값) gtag.js 스크립트 자체를 렌더링하지
# 않는다(src/lib/analytics.ts 참고).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
