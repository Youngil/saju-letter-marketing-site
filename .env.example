# saju-letter-backend가 실제로 호스팅되는 주소 — 이 사이트의 모든 API 호출 대상.
# 로컬 개발 기본값(saju-letter-backend를 `npm run dev`로 띄운 경우): http://localhost:4000
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# 이 사이트 자신이 실제로 호스팅되는 주소 — 공유 링크(OG 태그의 og:url)와 이메일 CTA에 쓴다.
# 로컬 개발 기본값: http://localhost:3200(saju-letter-newyear-campaign의 3100과 겹치지
# 않게 — 이관 전환기에 두 사이트를 동시에 띄울 수 있어야 한다).
NEXT_PUBLIC_WEB_BASE_URL="http://localhost:3200"

# Google Play 스토어 앱 설치 링크 — 데모/블로그/이메일 CTA에서 공통으로 쓴다.
NEXT_PUBLIC_GOOGLE_PLAY_URL="https://play.google.com/store/apps/details?id=com.sajuletter.app"

# Cloudflare Turnstile 사이트 키(공개 키, 시크릿 키는 saju-letter-backend 쪽에 별도로 있음).
# 생략하면(로컬 개발 기본값) 위젯 자체를 렌더링하지 않는다 — 봇 방지 없이 폼 제출은 그대로 된다
# (백엔드의 fail-open과 짝을 이룸). 실제 서비스 오픈 전 Cloudflare 대시보드에서 발급받을 것.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
